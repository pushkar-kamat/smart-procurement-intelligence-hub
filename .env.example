# =========================================================
# SMART PROCUREMENT INTELLIGENCE HUB
# Local Development Environment Example
# =========================================================

# -------------------------
# Application
# -------------------------
ENVIRONMENT=development

# -------------------------
# PostgreSQL
# -------------------------
POSTGRES_USER=procurement
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_DB=procurement

# FastAPI running locally + PostgreSQL running in Docker
DATABASE_URL=postgresql+psycopg://procurement:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5432/procurement

# -------------------------
# Frontend / CORS
# -------------------------
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# -------------------------
# Supabase Authentication
# -------------------------
# Example:
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Use the Supabase publishable/anon client key.
# This value may also be used by the frontend.
SUPABASE_ANON_KEY=

# Backend only.
# NEVER place this key inside frontend/.env or any VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_JWT_AUDIENCE=authenticated

# -------------------------
# File Storage
# -------------------------
# Use "local" during development.
# Change to "supabase" later if using Supabase Storage.
STORAGE_BACKEND=local

LOCAL_UPLOAD_DIR=./uploads

# Required only when STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=procurement-documents

# Maximum quotation/document upload size
MAX_UPLOAD_MB=10

# -------------------------
# Price Anomaly Detection
# -------------------------
# A quotation more than 25% above the historical median
# may be flagged as anomalous.
PRICE_ANOMALY_PERCENT_THRESHOLD=25

# -------------------------
# Vendor Risk Configuration
# -------------------------
# Low:    0 - 29.99
# Medium: 30 - 59.99
# High:   60+
RISK_LOW_MAX=29.99
RISK_MEDIUM_MAX=59.99

# -------------------------
# Invoice Validation
# -------------------------
# Flag invoice/PO differences above 5%
INVOICE_MISMATCH_PERCENT_THRESHOLD=5

# -------------------------
# Demo Account Seeding
# -------------------------
# Optional.
# Only needed when running app.seed_users.
# Must be at least 12 characters.
DEMO_PASSWORD=

# Authentication provider: supabase or local
AUTH_PROVIDER=supabase
# LOCAL_AUTH_SECRET=replace-with-a-long-random-server-only-secret
LOCAL_AUTH_TOKEN_MINUTES=480
